DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 自适应 RAG（/api/work）；设为 false 则始终走旧版固定检索链路
ADAPTIVE_RAG_WORK=true

# getWorkLore 内存缓存（同 normalized query + adaptive/legacy 模式）；不缓存失败结果
WORK_LORE_CACHE_ENABLED=true
WORK_LORE_CACHE_TTL_MS=86400000

# 可选：Upstash Redis REST。配置后昂贵接口的限流在多实例间共享；未配置时安全降级为单实例内存限流。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 作品页四卡 SSE 逐字流式（/api/work/stream）；false 时走服务端 getWorkLore
WORK_LORE_STREAMING=false
# 流式：单卡 LLM 最长等待（毫秒）；超时后发 card_done 占位并继续下一张
WORK_LORE_STREAM_CARD_TIMEOUT_MS=45000
# 流式：整条 SSE 连接最长等待（毫秒）
WORK_LORE_STREAM_TOTAL_TIMEOUT_MS=180000
# 流式：前端无 SSE 事件（含 ping）后触发 fallback（毫秒）
WORK_LORE_STREAM_CLIENT_IDLE_MS=30000
# 流式：单条 delta 超过该长度时拆成打字机小片段
WORK_LORE_STREAM_TYPEWRITER_THRESHOLD=20
WORK_LORE_STREAM_TYPEWRITER_CHARS=4
WORK_LORE_STREAM_TYPEWRITER_DELAY_MS=20
RAG_MAX_ROUNDS=2
RAG_TOP_K=6
# 各外部源（Bangumi / 维基 / 萌百 / 社区）单次并行抓取超时（毫秒）
RAG_SOURCE_TIMEOUT_MS=8000
# true 时必须同时具备硬元数据 + 维基/萌娘长叙述
RAG_COVERAGE_STRICT=false
RAG_LOG_LEVEL=info

# debug API：GET /api/work/debug?q=…（仅 ADAPTIVE_RAG_WORK≠false 时可用，否则 400）
RAG_DEBUG_INCLUDE_PROMPT=false
RAG_DEBUG_TRUNCATE_SNIPPET=600

# RAG 数据源开关
RAG_ENABLE_BANGUMI=true
RAG_ENABLE_BILIBILI=true
RAG_ENABLE_NGA=true
RAG_ENABLE_AWEIDAO=true
# true 时 RAG 检索跳过 B站/NGA/aweidao（首屏加速；社区内容走 /api/work/community-recs）
RAG_DEFER_COMMUNITY_EVIDENCE=true
# 作品页异步模块超时（毫秒）
WORK_RELATED_TIMEOUT_MS=8000
WORK_COMMUNITY_RECS_CLIENT_TIMEOUT_MS=12000
# B站专栏搜索：从浏览器复制 Cookie（含 buvid3 更佳）；未配置时会先访问 bilibili.com 引导基础 Cookie
# BILIBILI_COOKIE=
# read/cv → opus 轻量解析超时（毫秒）；失败则保留 read/cv
BILIBILI_URL_RESOLVE_TIMEOUT_MS=1500
# 阿苇岛搜索 API 需登录态；从浏览器复制 Cookie 填入（可选）
# RAG_AWEIDAO_COOKIE=

# Gemini 交叉验证：仅 /api/work/debug 会阻塞等待；作品页首屏不等待校验结果
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# 设为 false 关闭校验
# 作品页不等待 Gemini；仅 debug API 会执行校验
GEMINI_VERIFY_LORE=false
# 整体置信度低于该值（0~1）时降级为 low_risk 或 insufficient
GEMINI_VERIFY_THRESHOLD=0.55

# 首页「今日冷知识」：library_only=只读内容库；library_first=库不足才生成；generate_only=总是生成
HOME_HOOK_MODE=library_only
# balanced=刷新时轮换主题；stable=同一天 TTL 内固定一条
HOME_HOOK_ROTATION_MODE=balanced
HOME_HOOK_CACHE_TTL_MS=86400000
HOME_HOOK_GENERATE_ON_MISS=true
HOME_HOOK_RECENT_TOPIC_WINDOW=10
# 开发环境默认每次访问跳过 TTL（仍可用库轮换）；设为 false 可恢复同日缓存
HOME_HOOK_FORCE_REFRESH_IN_DEV=true
# 开发清库：npm run cold:clear（清空 data/cold-hooks.json；dev 运行时并 POST /api/hook/clear）
# 预生成精品库：npm run cold:seed -- --count=50 --reset --fact-heavy
# 查看库质量：npm run cold:stats
# 强制新生成：/?refreshHook=1 或 GET /api/hook?refresh=1&debug=1（development 下跳过旧库）

# 作品页底部「中文社区考据与创作推荐」（延伸阅读，不参与四卡硬事实）
# 默认开启；仅在需要暂停外部社区检索时设为 false
COMMUNITY_RECS_ENABLED=true
COMMUNITY_RECS_MAX=3
COMMUNITY_RECS_SOURCES=curated,bilibili,nga,aweidao
COMMUNITY_RECS_QUERY_LIMIT=6
COMMUNITY_RECS_FETCH_TIMEOUT_MS=3000
# 社区源抓取总预算（毫秒）；LLM 推荐语另计 COMMUNITY_RECS_REASONER_TIMEOUT_MS
COMMUNITY_RECS_TIMEOUT_MS=10000
COMMUNITY_RECS_REASONER_TIMEOUT_MS=8000
# 抓取时是否将 read/cv 解析为 opus（更慢；false 时仍可用搜索项里的 opus 直链）
# true 时抓取阶段会把 read/cv 解析为 opus（更慢）
COMMUNITY_RECS_RESOLVE_OPUS=false
